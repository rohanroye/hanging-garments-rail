{% comment %}
  Section: Hanging Garments Rail (v2)
  - Real steel bar (CSS) that every garment hangs from. Finish: steel / matte black / brass.
  - Infinite horizontal carousel (drag, swipe, trackpad, arrows).
  - Hover (desktop): garment turns to face you (side image -> front image), grows, swings slightly;
    neighbours slide apart; caption appears. Arrows + button fade out while hovering.
  - Click / tap: garment lifts off the rail into a blurred popup, with browse arrows.
  - Premium extras: soft edge fade, deeper shadow on the active garment, slide counter, minimal arrows.

  Use transparent PNG/WebP cut-outs with the hanger included.
{% endcomment %}

{%- assign n = section.blocks.size -%}
{%- assign ov_alpha = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign ov_color = section.settings.overlay_color | color_modify: 'alpha', ov_alpha -%}
{%- assign ov_solid = section.settings.overlay_color | color_modify: 'alpha', 0.94 -%}

{%- case section.settings.rail_finish -%}
  {%- when 'black' -%}
    {%- assign rail_bg = 'linear-gradient(180deg, #0b0b0c 0%, #2a2b2e 20%, #4d4f55 38%, #1c1d20 68%, #050505 100%)' -%}
    {%- assign rail_hl = 'rgba(255,255,255,0.35)' -%}
  {%- when 'brass' -%}
    {%- assign rail_bg = 'linear-gradient(180deg, #5b4420 0%, #a8864a 16%, #ecd9a0 38%, #b9954f 60%, #7a5c2b 82%, #3d2c12 100%)' -%}
    {%- assign rail_hl = 'rgba(255,255,255,0.6)' -%}
  {%- else -%}
    {%- assign rail_bg = 'linear-gradient(180deg, #2b3036 0%, #69717b 14%, #c7ccd3 30%, #ffffff 44%, #aeb4bd 60%, #6a727c 82%, #23272c 100%)' -%}
    {%- assign rail_hl = 'rgba(255,255,255,0.9)' -%}
{%- endcase -%}

<section
  id="hr-{{ section.id }}"
  class="hr-section{% if section.settings.swing %} hr-swing-on{% endif %}"
  data-hr-section
  data-count="{{ n }}"
  style="
    --hr-bg: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}
      --hr-bg-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    {% else %}
      --hr-bg-image: none;
    {% endif %}
    --hr-text: {{ section.settings.text_color }};
    --hr-smax: {{ section.settings.hover_scale }};
    --hr-dim: {{ section.settings.dim_others | divided_by: 100.0 }};
    --hr-pt: {{ section.settings.padding_top }}px;
    --hr-pb: {{ section.settings.padding_bottom }}px;
    --hr-hs: {{ section.settings.heading_size }}px;
    --hr-rail-h: {{ section.settings.rail_height }}px;
    --hr-drop: {{ section.settings.garment_drop }}px;
    --hr-fade: {{ section.settings.edge_fade }}%;
    --hr-dock-gap: {{ section.settings.dock_gap }}px;
  "
>
  {%- if section.settings.logo != blank or section.settings.heading != blank -%}
    <div class="hr-top">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag:
            class: 'hr-logo',
            loading: 'eager',
            widths: '120, 240, 360, 480',
            sizes: '240px',
            style: 'width: 100%; height: auto;',
            alt: section.settings.heading | escape
        }}
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hr-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if n > 0 -%}
    <div class="hr-carousel-outer">
      {%- comment -%} The bar is the same at every scroll position, so it lives OUTSIDE the scroller: full width, never clipped or masked. {%- endcomment -%}
      {%- if section.settings.show_rail -%}
        <div class="hr-rail" aria-hidden="true"></div>
      {%- endif -%}

      <div class="hr-scroller" data-hr-scroller>
        <div class="hr-track" data-hr-track>

          {%- comment -%} Three identical sets so the carousel can loop forever. Only the middle set is exposed to screen readers / the theme editor. {%- endcomment -%}
          {%- for copy in (1..3) -%}
            {%- for block in section.blocks -%}
              {%- assign product = block.settings.product -%}

              {%- assign side_media = block.settings.side_image -%}
              {%- if side_media == blank and product != blank -%}{%- assign side_media = product.featured_image -%}{%- endif -%}

              {%- assign front_media = block.settings.front_image -%}
              {%- if front_media == blank -%}{%- assign front_media = side_media -%}{%- endif -%}

              {%- assign title = block.settings.title -%}
              {%- if title == blank and product != blank -%}{%- assign title = product.title -%}{%- endif -%}

              {%- assign price = block.settings.price -%}
              {%- if price == blank and product != blank -%}{%- assign price = product.price | money -%}{%- endif -%}

              {%- assign url = block.settings.link -%}
              {%- if url == blank and product != blank -%}{%- assign url = product.url -%}{%- endif -%}

              {%- assign desc = block.settings.description -%}
              {%- if desc == blank and product != blank -%}{%- assign desc = product.description | strip_html | truncate: 170 -%}{%- endif -%}

              {%- assign compare = '' -%}
              {%- assign soldout = false -%}
              {%- if product != blank -%}
                {%- if block.settings.price == blank and product.compare_at_price > product.price -%}
                  {%- assign compare = product.compare_at_price | money -%}
                {%- endif -%}
                {%- unless product.available -%}{%- assign soldout = true -%}{%- endunless -%}
              {%- endif -%}

              {%- assign load = 'lazy' -%}
              {%- if copy == 2 and forloop.index <= 4 -%}{%- assign load = 'eager' -%}{%- endif -%}

              <div class="hr-slot" data-hr-slot {% if copy == 2 %}{{ block.shopify_attributes }}{% endif %}>
                <button
                  type="button"
                  class="hr-item"
                  aria-haspopup="dialog"
                  {% if copy != 2 %}tabindex="-1" aria-hidden="true"{% endif %}
                  aria-label="{% if title != blank %}{{ title | escape }}{% else %}Garment {{ forloop.index }}{% endif %}"
                  data-title="{{ title | escape }}"
                  data-price="{{ price | escape }}"
                  data-desc="{{ desc | escape }}"
                  data-url="{{ url | escape }}"
                  data-compare="{{ compare | escape }}"
                  data-soldout="{{ soldout }}"
                  {%- if front_media != blank %} data-full="{{ front_media | image_url: width: 1400 }}"{% endif %}
                >
                  <span class="hr-scale">
                    <span class="hr-swing">
                      <span class="hr-flip-wrap">
                        {%- if side_media != blank -%}
                          {{
                            side_media
                            | image_url: width: 1200
                            | image_tag:
                              class: 'hr-img hr-img--side',
                              loading: load,
                              widths: '400, 600, 900, 1200',
                              sizes: '(min-width: 750px) 15vw, 45vw',
                              alt: title | escape
                          }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'hr-img hr-img--side hr-placeholder' }}
                        {%- endif -%}

                        {%- if front_media != blank -%}
                          {{
                            front_media
                            | image_url: width: 1200
                            | image_tag:
                              class: 'hr-img hr-img--front',
                              loading: load,
                              widths: '400, 600, 900, 1200',
                              sizes: '(min-width: 750px) 15vw, 45vw',
                              alt: ''
                          }}
                        {%- else -%}
                          {{ 'product-2' | placeholder_svg_tag: 'hr-img hr-img--front hr-placeholder' }}
                        {%- endif -%}
                      </span>
                    </span>
                  </span>
                </button>

                {%- if section.settings.show_caption and title != blank -%}
                  <div class="hr-caption" aria-hidden="true">
                    <span class="hr-caption__title">{{ title | escape }}</span>
                    {%- if price != blank -%}<span class="hr-caption__price">{{ price | escape }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Dock: arrows + counter + button, sitting right under the resting garments. {%- endcomment -%}
      <div class="hr-dock" data-hr-dock>
        <div class="hr-nav">
          <button type="button" class="hr-arrow hr-arrow--prev" data-hr-scroll-prev aria-label="Previous garments">
            <svg width="38" height="12" viewBox="0 0 38 12" fill="none" aria-hidden="true"><path d="M37 6H1M6 1L1 6l5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          {%- if section.settings.show_counter -%}
            <span class="hr-counter" data-hr-counter aria-hidden="true">01 / {% if n < 10 %}0{% endif %}{{ n }}</span>
          {%- endif -%}
          <button type="button" class="hr-arrow hr-arrow--next" data-hr-scroll-next aria-label="Next garments">
            <svg width="38" height="12" viewBox="0 0 38 12" fill="none" aria-hidden="true"><path d="M1 6h36M32 1l5 5-5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        {%- if section.settings.cta_label != blank -%}
          {%- if section.settings.cta_link != blank -%}
            <a class="hr-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
          {%- else -%}
            <span class="hr-cta">{{ section.settings.cta_label | escape }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div
    class="hr-modal"
    id="hr-modal-{{ section.id }}"
    data-hr-modal
    data-for="{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Garment details"
    style="
      --hr-blur: {{ section.settings.blur_amount }}px;
      --hr-ov: {{ ov_color }};
      --hr-ov-solid: {{ ov_solid }};
      --hr-mtext: {{ section.settings.modal_text_color }};
      --hr-mh: {{ section.settings.modal_image_height }}svh;
    "
  >
    <div class="hr-modal__backdrop" data-hr-close></div>
    <div class="hr-modal__panel">
      <button type="button" class="hr-modal__close" data-hr-close aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      </button>
      <button type="button" class="hr-modal__nav hr-modal__nav--prev" data-hr-prev aria-label="Previous garment">
        <svg width="38" height="12" viewBox="0 0 38 12" fill="none" aria-hidden="true"><path d="M37 6H1M6 1L1 6l5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="hr-modal__nav hr-modal__nav--next" data-hr-next aria-label="Next garment">
        <svg width="38" height="12" viewBox="0 0 38 12" fill="none" aria-hidden="true"><path d="M1 6h36M32 1l5 5-5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <img class="hr-modal__img" data-hr-modal-img alt="" decoding="async">

      <div class="hr-modal__info" data-hr-info>
        <h3 class="hr-modal__title" data-hr-title></h3>
        <p class="hr-modal__price" data-hr-price-wrap>
          <s class="hr-modal__compare" data-hr-compare></s>
          <span data-hr-price></span>
          <span class="hr-modal__soldout" data-hr-soldout hidden>{{ section.settings.soldout_label | escape }}</span>
        </p>
        <p class="hr-modal__desc" data-hr-desc></p>
        <a class="hr-modal__link" data-hr-link href="#">
          <span>{{ section.settings.product_button_label | escape }}</span>
          <svg width="26" height="10" viewBox="0 0 26 10" fill="none" aria-hidden="true"><path d="M1 5h23M20 1l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="hr-modal__hint" data-hr-hint hidden>Theme editor tip: choose a product (or fill in a title, price and link) in this garment block so the name, price and product link appear here.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #hr-{{ section.id }} {
    --hr-h: {{ section.settings.garment_height }}svh;
    --hr-slot-w: {{ section.settings.slot_width }}vw;
    --hr-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --hr-rail-bg: {{ rail_bg }};
    --hr-rail-hl: {{ rail_hl }};
    position: relative;
    display: block;
    width: {{ section.settings.section_width }}%;
    margin: 0 auto;
    padding: var(--hr-pt) 0 var(--hr-pb);
    background-color: var(--hr-bg);
    background-image: var(--hr-bg-image, none);
    background-size: cover;
    background-position: {{ section.settings.background_image_position }};
    background-repeat: no-repeat;
    color: var(--hr-text);
    overflow: hidden;
  }

  #hr-{{ section.id }} *,
  #hr-{{ section.id }} *::before,
  #hr-{{ section.id }} *::after { box-sizing: border-box; }

  /* ---------- Top ---------- */
  #hr-{{ section.id }} .hr-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 0 20px 20px;
    text-align: center;
  }
  #hr-{{ section.id }} .hr-logo { width: {{ section.settings.logo_width }}px; max-width: 60vw; height: auto; }
  #hr-{{ section.id }} .hr-heading {
    margin: 0;
    font-size: var(--hr-hs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
  }

  #hr-{{ section.id }} .hr-carousel-outer { position: relative; width: 100%; }

  /* ---------- Scroller + track ---------- */
  #hr-{{ section.id }} .hr-scroller {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    {% if section.settings.edge_fade > 0 %}
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--hr-fade), #000 calc(100% - var(--hr-fade)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--hr-fade), #000 calc(100% - var(--hr-fade)), transparent 100%);
    {% endif %}
  }
  #hr-{{ section.id }} .hr-scroller::-webkit-scrollbar { display: none; }
  #hr-{{ section.id }} .hr-scroller.is-dragging { cursor: grabbing; }

  #hr-{{ section.id }} .hr-track {
    position: relative;
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    width: max-content;
    min-width: 100%;
    padding: var(--hr-drop) 0 0;
    /* room for the enlarged hovered garment + its caption */
    min-height: max(
      calc(var(--hr-drop) + var(--hr-h) * var(--hr-smax) + 56px),
      calc(var(--hr-drop) + var(--hr-h) + var(--hr-dock-gap) + 140px)
    );
  }

  /* ---------- Steel bar ---------- */
  #hr-{{ section.id }} .hr-rail {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--hr-rail-h);
    z-index: 0;
    pointer-events: none;
    background: var(--hr-rail-bg);
    box-shadow:
      0 12px 16px -8px rgba(0, 0, 0, 0.38),
      0 2px 3px rgba(0, 0, 0, 0.28);
  }
  #hr-{{ section.id }} .hr-rail::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    height: 1px;
    background: var(--hr-rail-hl);
  }

  /* ---------- Slots ---------- */
  #hr-{{ section.id }} .hr-slot {
    position: relative;
    flex: 0 0 var(--hr-slot-w);
    min-width: 0;
    height: var(--hr-h);
    z-index: 1;
    transform: translate3d(calc(var(--dx, 0) * 1%), 0, 0);
    transition: transform 0.65s var(--hr-ease), opacity 0.4s ease;
  }
  #hr-{{ section.id }} .hr-slot.is-active { z-index: 5; }
  #hr-{{ section.id }} .hr-track.has-active .hr-slot:not(.is-active) { opacity: var(--hr-dim); }

  #hr-{{ section.id }} .hr-item {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #hr-{{ section.id }} .hr-item:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }

  #hr-{{ section.id }} .hr-scale {
    display: block;
    width: 100%;
    height: 100%;
    transform: scale(var(--s, 1));
    transform-origin: 50% 0;
    transition: transform 0.65s var(--hr-ease), opacity 0.25s ease, filter 0.5s ease;
    will-change: transform;
  }
  #hr-{{ section.id }} .hr-slot.is-active .hr-scale {
    filter: drop-shadow(0 26px 24px rgba(0, 0, 0, 0.2));
  }

  #hr-{{ section.id }} .hr-swing { display: block; width: 100%; height: 100%; transform-origin: 50% 0; }

  /* 3D turn: side view -> front view */
  #hr-{{ section.id }} .hr-flip-wrap {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    perspective: 1400px;
    -webkit-perspective: 1400px;
    transform-style: preserve-3d;
  }

  #hr-{{ section.id }} .hr-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 0;
    -webkit-user-drag: none;
    user-select: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }
  #hr-{{ section.id }} .hr-img--side  { opacity: 1; transform: rotateY(0deg) scale(1); }
  #hr-{{ section.id }} .hr-img--front { opacity: 0; transform: rotateY(-80deg) scale(0.95); pointer-events: none; }
  #hr-{{ section.id }} .hr-slot.is-active .hr-img--side  { opacity: 0; transform: rotateY(80deg) scale(0.95); }
  #hr-{{ section.id }} .hr-slot.is-active .hr-img--front { opacity: 1; transform: rotateY(0deg) scale(1); }

  #hr-{{ section.id }} .hr-placeholder { opacity: 0.5; }

  @keyframes hr-swing-{{ section.id }} {
    0%   { transform: rotate(0deg); }
    25%  { transform: rotate(2.2deg); }
    55%  { transform: rotate(-1.4deg); }
    80%  { transform: rotate(0.6deg); }
    100% { transform: rotate(0deg); }
  }
  #hr-{{ section.id }}.hr-swing-on .hr-slot.is-active .hr-swing {
    animation: hr-swing-{{ section.id }} 1.1s ease-out 1;
  }

  #hr-{{ section.id }} .hr-slot.is-lifted .hr-scale { opacity: 0; transition: none; }
  #hr-{{ section.id }} .hr-slot.is-lifted .hr-caption { opacity: 0 !important; }

  /* ---------- Caption ---------- */
  #hr-{{ section.id }} .hr-caption {
    position: absolute;
    left: 50%;
    top: calc(var(--s, 1) * var(--hr-h) + 12px);
    width: max-content;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: center;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-50%, 6px, 0);
    transition: opacity 0.35s ease, top 0.65s var(--hr-ease), transform 0.5s var(--hr-ease);
  }
  #hr-{{ section.id }} .hr-caption__price { opacity: 0.6; letter-spacing: 0.08em; }
  #hr-{{ section.id }} .hr-slot.is-active .hr-caption { opacity: 1; transform: translate3d(-50%, 0, 0); }

  /* ---------- Dock: arrows, counter, button ---------- */
  #hr-{{ section.id }} .hr-dock {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--hr-drop) + var(--hr-h) + var(--hr-dock-gap));
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.45s var(--hr-ease);
  }
  #hr-{{ section.id }} .hr-dock > * { pointer-events: auto; }
  #hr-{{ section.id }}.hr-has-active .hr-dock { opacity: 0; transform: translate3d(0, 8px, 0); }
  #hr-{{ section.id }}.hr-has-active .hr-dock > * { pointer-events: none; }

  #hr-{{ section.id }} .hr-nav { display: flex; align-items: center; gap: 20px; }

  #hr-{{ section.id }} .hr-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 12px 8px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.3s ease, transform 0.4s var(--hr-ease);
  }
  #hr-{{ section.id }} .hr-arrow:hover,
  #hr-{{ section.id }} .hr-arrow:focus-visible { opacity: 1; }
  #hr-{{ section.id }} .hr-arrow--prev:hover { transform: translate3d(-5px, 0, 0); }
  #hr-{{ section.id }} .hr-arrow--next:hover { transform: translate3d(5px, 0, 0); }
  #hr-{{ section.id }} .hr-arrow:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }

  #hr-{{ section.id }} .hr-counter {
    min-width: 5.6em;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.22em;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  #hr-{{ section.id }} .hr-cta {
    display: inline-block;
    padding: 12px 28px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  #hr-{{ section.id }} a.hr-cta:hover { background: var(--hr-text); color: var(--hr-bg); }

  /* ---------- Popup ---------- */
  #hr-modal-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    visibility: hidden;
    color: var(--hr-mtext);
  }
  #hr-modal-{{ section.id }}.is-visible { visibility: visible; }
  #hr-modal-{{ section.id }} * { box-sizing: border-box; }

  #hr-modal-{{ section.id }} .hr-modal__backdrop {
    position: absolute;
    inset: 0;
    background-color: transparent;
    -webkit-backdrop-filter: blur(0px);
    backdrop-filter: blur(0px);
    transition: background-color 0.5s ease, backdrop-filter 0.5s ease, -webkit-backdrop-filter 0.5s ease;
    cursor: zoom-out;
  }
  #hr-modal-{{ section.id }}.is-open .hr-modal__backdrop {
    background-color: var(--hr-ov);
    -webkit-backdrop-filter: blur(var(--hr-blur));
    backdrop-filter: blur(var(--hr-blur));
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    #hr-modal-{{ section.id }}.is-open .hr-modal__backdrop { background-color: var(--hr-ov-solid); }
  }

  #hr-modal-{{ section.id }} .hr-modal__panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 64px 24px 32px;
    pointer-events: none;
  }
  #hr-modal-{{ section.id }} .hr-modal__panel > * { pointer-events: auto; }

  #hr-modal-{{ section.id }} .hr-modal__img {
    display: block;
    height: min(var(--hr-mh), calc(100svh - 300px));
    min-height: 200px;
    width: auto;
    max-width: 88vw;
    object-fit: contain;
    -webkit-user-drag: none;
    user-select: none;
    will-change: transform;
    filter: drop-shadow(0 30px 34px rgba(0, 0, 0, 0.22));
  }

  #hr-modal-{{ section.id }} .hr-modal__info {
    max-width: 460px;
    text-align: center;
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition: opacity 0.35s ease, transform 0.5s var(--hr-ease);
  }
  #hr-modal-{{ section.id }}.is-ready .hr-modal__info {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: 0.25s;
  }

  #hr-modal-{{ section.id }} .hr-modal__title { margin: 0; font-size: 22px; font-weight: 500; line-height: 1.25; color: inherit; }
  #hr-modal-{{ section.id }} [hidden] { display: none !important; }
  #hr-modal-{{ section.id }} .hr-modal__title:empty { display: none; }
  #hr-modal-{{ section.id }} .hr-modal__price {
    margin: 8px 0 0;
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 10px;
    font-size: 16px;
    letter-spacing: 0.04em;
  }
  #hr-modal-{{ section.id }} .hr-modal__compare { opacity: 0.5; font-size: 14px; }
  #hr-modal-{{ section.id }} .hr-modal__soldout {
    padding: 3px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  #hr-modal-{{ section.id }} .hr-modal__hint {
    margin: 16px 0 0;
    padding: 10px 14px;
    border: 1px dashed currentColor;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.75;
  }
  #hr-modal-{{ section.id }} .hr-modal__desc { margin: 12px 0 0; font-size: 14px; line-height: 1.6; opacity: 0.8; }
  #hr-modal-{{ section.id }} .hr-modal__price:empty,
  #hr-modal-{{ section.id }} .hr-modal__desc:empty { display: none; }
  #hr-modal-{{ section.id }} .hr-modal__link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    padding: 15px 32px;
    border: 1px solid var(--hr-mtext);
    border-radius: 999px;
    background: var(--hr-mtext);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  #hr-modal-{{ section.id }} .hr-modal__link svg { transition: transform 0.35s var(--hr-ease); }
  #hr-modal-{{ section.id }} .hr-modal__link:hover { background: transparent; color: var(--hr-mtext); }
  #hr-modal-{{ section.id }} .hr-modal__link:hover svg { transform: translate3d(5px, 0, 0); }
  #hr-modal-{{ section.id }} .hr-modal__link[hidden] { display: none; }

  /* popup controls: no circles, just thin line icons */
  #hr-modal-{{ section.id }} .hr-modal__close,
  #hr-modal-{{ section.id }} .hr-modal__nav {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 14px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.4s ease 0.2s, transform 0.4s var(--hr-ease);
  }
  #hr-modal-{{ section.id }}.is-open .hr-modal__close,
  #hr-modal-{{ section.id }}.is-open .hr-modal__nav { opacity: 0.6; }
  #hr-modal-{{ section.id }}.is-open .hr-modal__close:hover,
  #hr-modal-{{ section.id }}.is-open .hr-modal__nav:hover,
  #hr-modal-{{ section.id }}.is-open .hr-modal__close:focus-visible,
  #hr-modal-{{ section.id }}.is-open .hr-modal__nav:focus-visible { opacity: 1; transition-delay: 0s; }
  #hr-modal-{{ section.id }} .hr-modal__close { top: 18px; right: 18px; }
  #hr-modal-{{ section.id }} .hr-modal__nav { top: 50%; margin-top: -26px; }
  #hr-modal-{{ section.id }} .hr-modal__nav--prev { left: 24px; }
  #hr-modal-{{ section.id }} .hr-modal__nav--next { right: 24px; }
  #hr-modal-{{ section.id }} .hr-modal__nav--prev:hover { transform: translate3d(-5px, 0, 0); }
  #hr-modal-{{ section.id }} .hr-modal__nav--next:hover { transform: translate3d(5px, 0, 0); }
  #hr-modal-{{ section.id }} .hr-modal__close:focus-visible,
  #hr-modal-{{ section.id }} .hr-modal__nav:focus-visible,
  #hr-modal-{{ section.id }} .hr-modal__link:focus-visible { outline: 1px solid currentColor; outline-offset: 3px; }
  #hr-modal-{{ section.id }}.hr-single .hr-modal__nav { display: none; }

  /* ---------- Reduced motion (optional setting) ---------- */
  #hr-{{ section.id }}.hr-static *,
  #hr-modal-{{ section.id }}.hr-static * {
    transition-duration: 0.01s !important;
    transition-delay: 0s !important;
    animation: none !important;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 749px) {
    #hr-{{ section.id }} {
      width: {{ section.settings.section_width_mobile }}%;
      --hr-h: {{ section.settings.garment_height_mobile }}svh;
      --hr-slot-w: {{ section.settings.slot_width_mobile }}vw;
    }
    /* no hover on touch, so no spare room is needed */
    #hr-{{ section.id }} .hr-track { min-height: calc(var(--hr-drop) + var(--hr-h)); }
    #hr-{{ section.id }} .hr-caption { display: none; }
    #hr-{{ section.id }} .hr-dock {
      position: static;
      padding-top: max(22px, calc(var(--hr-dock-gap) * 0.6));
      pointer-events: auto;
    }
    #hr-{{ section.id }}.hr-has-active .hr-dock { opacity: 1; transform: none; }
    #hr-modal-{{ section.id }} .hr-modal__panel { padding: 70px 20px 28px; gap: 18px; }
    #hr-modal-{{ section.id }} .hr-modal__nav { top: auto; bottom: 22px; margin-top: 0; }
    #hr-modal-{{ section.id }} .hr-modal__nav--prev { left: 14px; }
    #hr-modal-{{ section.id }} .hr-modal__nav--next { right: 14px; }
    #hr-modal-{{ section.id }} .hr-modal__title { font-size: 19px; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('hr-{{ section.id }}');
    if (!root) return;
    if (typeof root.__hrCleanup === 'function') root.__hrCleanup();

    const SECTION_ID = '{{ section.id }}';
    const HOVER_SCALE = {{ section.settings.hover_scale }};
    const RESPECT_REDUCED_MOTION = {{ section.settings.respect_reduced_motion | json }};

    const scroller = root.querySelector('[data-hr-scroller]');
    const track = root.querySelector('[data-hr-track]');
    const modal = root.querySelector('[data-hr-modal]');
    const scrollPrev = root.querySelector('[data-hr-scroll-prev]');
    const scrollNext = root.querySelector('[data-hr-scroll-next]');
    const counterEl = root.querySelector('[data-hr-counter]');
    if (!track || !modal || !scroller) return;

    // Remove popups left behind by an earlier render of this section (theme editor).
    document.querySelectorAll('[data-hr-modal][data-for="' + SECTION_ID + '"]').forEach((el) => {
      if (el !== modal && el.parentNode === document.body) el.parentNode.removeChild(el);
    });
    document.body.appendChild(modal);

    const STATIC = RESPECT_REDUCED_MOTION && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const FLIP_MS = STATIC ? 10 : 700;
    const FLIP_TRANSITION = 'transform ' + FLIP_MS + 'ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease';
    if (STATIC) { root.classList.add('hr-static'); modal.classList.add('hr-static'); }

    const rawSlots = [].slice.call(root.querySelectorAll('[data-hr-slot]'));
    const total = rawSlots.length / 3; // garments per set
    if (!rawSlots.length) return;

    const items = rawSlots.map((slot) => {
      const btn = slot.querySelector('.hr-item');
      return {
        slot: slot,
        btn: btn,
        scale: slot.querySelector('.hr-scale'),
        side: slot.querySelector('.hr-img--side'),
        front: slot.querySelector('.hr-img--front'),
        data: {
          title: btn.dataset.title || '',
          price: btn.dataset.price || '',
          desc: btn.dataset.desc || '',
          url: btn.dataset.url || '',
          compare: btn.dataset.compare || '',
          soldout: btn.dataset.soldout === 'true',
          full: btn.dataset.full || ''
        }
      };
    });
    if (total < 2) modal.classList.add('hr-single');

    const modalImg = modal.querySelector('[data-hr-modal-img]');
    const titleEl = modal.querySelector('[data-hr-title]');
    const priceEl = modal.querySelector('[data-hr-price]');
    const priceWrap = modal.querySelector('[data-hr-price-wrap]');
    const compareEl = modal.querySelector('[data-hr-compare]');
    const soldEl = modal.querySelector('[data-hr-soldout]');
    const hintEl = modal.querySelector('[data-hr-hint]');
    const DESIGN_MODE = !!(window.Shopify && window.Shopify.designMode);
    const descEl = modal.querySelector('[data-hr-desc]');
    const linkEl = modal.querySelector('[data-hr-link]');
    const closeBtn = modal.querySelector('.hr-modal__close');
    const prevBtn = modal.querySelector('[data-hr-prev]');
    const nextBtn = modal.querySelector('[data-hr-next]');

    let active = -1;
    let current = -1;
    let modalOpen = false;
    let closing = false;
    let switching = false;
    let lastFocus = null;
    let pointerX = 0;
    let pointerY = 0;
    let moveTicking = false;
    let scrollLock = null;
    let alive = true;
    let closeTimer = 0;
    let idleTimer = 0;
    let counterTicking = false;
    let lastSetW = 0;

    /* ---------- Infinite loop ---------- */
    const setWidth = () => track.scrollWidth / 3;

    function normalise(force) {
      if (modalOpen || !alive) return;
      const w = setWidth();
      if (!w) return;
      const x = scroller.scrollLeft;
      const max = scroller.scrollWidth - scroller.clientWidth;
      if (x < w * 0.5 || (force && x < w)) { scroller.scrollLeft = x + w; }
      else if (x > w * 1.5 || (force && x > w * 2)) { scroller.scrollLeft = x - w; }
      else if (x <= 4) { scroller.scrollLeft = x + w; }
      else if (x >= max - 4) { scroller.scrollLeft = x - w; }
    }

    function slotWidth() { return rawSlots[0].offsetWidth || 1; }

    function updateCounter() {
      counterTicking = false;
      if (!counterEl || !alive) return;
      const sw = slotWidth();
      const center = scroller.scrollLeft + scroller.clientWidth / 2;
      let idx = Math.floor(center / sw) % total;
      if (idx < 0) idx += total;
      const pad = (v) => (v < 10 ? '0' + v : '' + v);
      counterEl.textContent = pad(idx + 1) + ' / ' + pad(total);
    }

    function onScroll() {
      if (!counterTicking) { counterTicking = true; window.requestAnimationFrame(updateCounter); }
      window.clearTimeout(idleTimer);
      // Jump by exactly one set when the scrolling settles (invisible, sets are identical).
      idleTimer = window.setTimeout(() => normalise(false), 90);
      // Emergency jump if the user hits a hard edge.
      const max = scroller.scrollWidth - scroller.clientWidth;
      if (!modalOpen && (scroller.scrollLeft <= 2 || scroller.scrollLeft >= max - 2)) normalise(false);
    }

    function startPosition() {
      const w = setWidth();
      lastSetW = w;
      if (w) scroller.scrollLeft = w;
      updateCounter();
    }

    function scrollByDir(dir) {
      scroller.scrollBy({ left: dir * slotWidth() * 2, behavior: STATIC ? 'auto' : 'smooth' });
    }

    /* ---------- Drag to scroll (mouse) ---------- */
    let down = false;
    let dragging = false;
    let suppressClick = false;
    let dragStartX = 0;
    let dragStartLeft = 0;
    let dragPointer = null;

    function onPointerDown(e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      dragging = false;
      dragStartX = e.clientX;
      dragStartLeft = scroller.scrollLeft;
      dragPointer = e.pointerId;
    }

    function onDragMove(e) {
      if (!down || e.pointerId !== dragPointer) return;
      const dx = e.clientX - dragStartX;
      if (!dragging && Math.abs(dx) > 6) {
        dragging = true;
        scroller.classList.add('is-dragging');
        try { scroller.setPointerCapture(dragPointer); } catch (err) { /* ignore */ }
        setActive(-1);
      }
      if (dragging) scroller.scrollLeft = dragStartLeft - dx;
    }

    function endDrag(e) {
      if (!down || (e && e.pointerId !== dragPointer)) return;
      if (dragging) {
        suppressClick = true;
        window.setTimeout(() => { suppressClick = false; }, 0);
        try { scroller.releasePointerCapture(dragPointer); } catch (err) { /* ignore */ }
      }
      down = false;
      dragging = false;
      scroller.classList.remove('is-dragging');
    }

    function onClickCapture(e) {
      if (suppressClick) { e.stopPropagation(); e.preventDefault(); suppressClick = false; }
    }

    /* ---------- Hover behaviour ---------- */
    function setActive(i) {
      if (i === active) return;
      active = i;
      track.classList.toggle('has-active', i >= 0);
      root.classList.toggle('hr-has-active', i >= 0);

      items.forEach((it, j) => {
        const s = it.slot;
        if (i < 0) {
          s.style.removeProperty('--dx');
          s.style.removeProperty('--s');
          s.classList.remove('is-active');
          return;
        }
        if (j === i) {
          s.style.setProperty('--dx', '0');
          s.style.setProperty('--s', String(HOVER_SCALE));
          s.classList.add('is-active');
        } else {
          const d = j - i;
          const falloff = Math.max(0.35, 1 - 0.15 * Math.abs(d));
          const dx = Math.sign(d) * (HOVER_SCALE - 1) * 50 * falloff;
          s.style.setProperty('--dx', dx.toFixed(2));
          s.style.setProperty('--s', '1');
          s.classList.remove('is-active');
        }
      });
    }

    function handleMove() {
      moveTicking = false;
      if (!alive || modalOpen || dragging) return;

      if (active >= 0) {
        const r = items[active].scale.getBoundingClientRect();
        if (pointerX >= r.left && pointerX <= r.right && pointerY >= r.top && pointerY <= r.bottom) return;
      }

      const tr = track.getBoundingClientRect();
      let found = -1;
      for (let j = 0; j < items.length; j++) {
        const s = items[j].slot;
        const left = tr.left + s.offsetLeft;
        const top = tr.top + s.offsetTop;
        if (pointerX >= left && pointerX < left + s.offsetWidth && pointerY >= top && pointerY <= top + s.offsetHeight) {
          found = j;
          break;
        }
      }
      setActive(found);
    }

    function onPointerMove(e) {
      if (e.pointerType === 'touch' || modalOpen) return;
      pointerX = e.clientX;
      pointerY = e.clientY;
      if (!moveTicking) {
        moveTicking = true;
        window.requestAnimationFrame(handleMove);
      }
    }

    function onPointerLeave(e) {
      if (e.pointerType === 'touch') return;
      setActive(-1);
    }

    function indexOfNode(node) {
      for (let j = 0; j < items.length; j++) if (items[j].slot.contains(node)) return j;
      return -1;
    }

    function onFocusIn(e) {
      if (modalOpen) return;
      const j = indexOfNode(e.target);
      if (j >= 0 && e.target.matches && e.target.matches(':focus-visible')) setActive(j);
    }

    function onFocusOut(e) {
      if (modalOpen) return;
      if (!e.relatedTarget || !track.contains(e.relatedTarget)) setActive(-1);
    }

    function onTrackClick(e) {
      const btn = e.target.closest ? e.target.closest('.hr-item') : null;
      if (!btn) return;
      const j = indexOfNode(btn);
      if (j >= 0) openModal(j);
    }

    /* ---------- Popup helpers ---------- */
    // The rectangle the garment image really occupies (object-fit: contain, aligned to the top).
    function drawnRect(img) {
      const r = img.getBoundingClientRect();
      if (img.tagName !== 'IMG' || !img.naturalWidth) return { left: r.left, top: r.top, width: r.width, height: r.height };
      const k = Math.min(r.width / img.naturalWidth, r.height / img.naturalHeight);
      const w = img.naturalWidth * k;
      const h = img.naturalHeight * k;
      return { left: r.left + (r.width - w) / 2, top: r.top, width: w, height: h };
    }

    // Whichever image is visible right now (front while hovered, side otherwise).
    function liveImg(it) {
      return it.slot.classList.contains('is-active') && it.front ? it.front : it.side;
    }

    function ensureVisible(it) {
      const r = it.slot.getBoundingClientRect();
      const sr = scroller.getBoundingClientRect();
      if (r.left < sr.left || r.right > sr.right) {
        scroller.scrollLeft = scroller.scrollLeft + (r.left - sr.left) - (sr.width - r.width) / 2;
      }
    }

    function imageReady(img) {
      return new Promise((resolve) => {
        if (img.complete && img.naturalWidth) return resolve();
        const done = () => { img.removeEventListener('load', done); img.removeEventListener('error', done); resolve(); };
        img.addEventListener('load', done);
        img.addEventListener('error', done);
        window.setTimeout(done, 1500);
      });
    }

    function fillModal(it) {
      const d = it.data;
      titleEl.textContent = d.title;
      priceEl.textContent = d.price;
      compareEl.textContent = d.compare;
      compareEl.hidden = !d.compare;
      soldEl.hidden = !d.soldout;
      priceWrap.hidden = !(d.price || d.compare || d.soldout);
      descEl.textContent = d.desc;
      descEl.hidden = !d.desc;
      if (d.url) { linkEl.href = d.url; linkEl.hidden = false; }
      else { linkEl.removeAttribute('href'); linkEl.hidden = true; }
      // In the theme editor, explain why the popup would otherwise look empty.
      if (hintEl) hintEl.hidden = !(DESIGN_MODE && !d.title && !d.price && !d.url);
    }

    function setModalImage(it) {
      const src = it.data.full || (it.front && it.front.currentSrc) || (it.side && it.side.currentSrc) || '';
      modalImg.style.visibility = src ? '' : 'hidden';
      modalImg.alt = it.data.title || '';
      if (src) modalImg.src = src;
    }

    function lockScroll() {
      if (scrollLock) return;
      const html = document.documentElement;
      const body = document.body;
      const sbw = window.innerWidth - html.clientWidth;
      scrollLock = { html: html.style.overflow, body: body.style.overflow, pad: body.style.paddingRight };
      html.style.overflow = 'hidden';
      body.style.overflow = 'hidden';
      if (sbw > 0) body.style.paddingRight = (parseFloat(window.getComputedStyle(body).paddingRight) || 0) + sbw + 'px';
    }

    function unlockScroll() {
      if (!scrollLock) return;
      document.documentElement.style.overflow = scrollLock.html;
      document.body.style.overflow = scrollLock.body;
      document.body.style.paddingRight = scrollLock.pad;
      scrollLock = null;
    }

    function flipTo(from, to) {
      const sx = from.width / to.width;
      const sy = from.height / to.height;
      modalImg.style.transition = 'none';
      modalImg.style.transformOrigin = '0 0';
      modalImg.style.transform = 'translate3d(' + (from.left - to.left) + 'px,' + (from.top - to.top) + 'px,0) scale(' + sx + ',' + sy + ')';
      void modalImg.offsetWidth;
      modalImg.style.transition = FLIP_TRANSITION;
      modalImg.style.transform = 'translate3d(0,0,0) scale(1,1)';
    }

    /* ---------- Open / close / browse ---------- */
    async function openModal(i) {
      if (modalOpen) return;
      modalOpen = true;
      closing = false;
      current = i;
      window.clearTimeout(closeTimer);

      const it = items[i];
      lastFocus = document.activeElement;
      const from = liveImg(it) ? drawnRect(liveImg(it)) : null; // measured while still hovered

      fillModal(it);
      lockScroll();
      setActive(-1);
      it.slot.classList.add('is-lifted');

      modalImg.style.transition = 'none';
      modalImg.style.opacity = '1';
      modalImg.style.transform = 'translate3d(0,0,0) scale(1,1)';
      setModalImage(it);

      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-visible');
      window.requestAnimationFrame(() => { if (modalOpen) modal.classList.add('is-open'); });

      await imageReady(modalImg);
      if (!modalOpen || closing || !alive) return;

      if (from && modalImg.src) flipTo(from, modalImg.getBoundingClientRect());
      modal.classList.add('is-ready');
      if (closeBtn) closeBtn.focus({ preventScroll: true });
      document.addEventListener('keydown', onKey);
    }

    function closeModal() {
      if (!modalOpen || closing) return;
      closing = true;
      document.removeEventListener('keydown', onKey);

      const it = items[current];
      modal.classList.remove('is-ready');
      ensureVisible(it); // after browsing, bring the garment's rail position on screen

      modalImg.style.transition = 'none';
      modalImg.style.opacity = '1';
      modalImg.style.transform = 'translate3d(0,0,0) scale(1,1)';
      const to = modalImg.getBoundingClientRect();
      const from = it.side ? drawnRect(it.side) : null; // its resting spot on the rail
      void modalImg.offsetWidth;

      modal.classList.remove('is-open');
      if (from && to.width && to.height) {
        modalImg.style.transition = FLIP_TRANSITION;
        modalImg.style.transform = 'translate3d(' + (from.left - to.left) + 'px,' + (from.top - to.top) + 'px,0) scale(' + (from.width / to.width) + ',' + (from.height / to.height) + ')';
      }

      closeTimer = window.setTimeout(finishClose, FLIP_MS + 60);
    }

    function finishClose() {
      const it = items[current];
      if (it) it.slot.classList.remove('is-lifted');
      modal.classList.remove('is-visible');
      modal.setAttribute('aria-hidden', 'true');
      unlockScroll();
      modalOpen = false;
      closing = false;
      switching = false;
      normalise(false);
      if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
    }

    function go(dir) {
      if (total < 2 || switching || closing || !modalOpen) return;
      switching = true;
      modal.classList.remove('is-ready');
      modalImg.style.transition = 'opacity 220ms ease';
      modalImg.style.opacity = '0';

      window.setTimeout(async () => {
        if (!modalOpen || closing || !alive) { switching = false; return; }
        const old = items[current];
        current = (current + dir + items.length) % items.length;
        const nx = items[current];
        old.slot.classList.remove('is-lifted');
        nx.slot.classList.add('is-lifted');
        ensureVisible(nx);
        fillModal(nx);
        setModalImage(nx);
        await imageReady(modalImg);
        if (!modalOpen || closing || !alive) { switching = false; return; }
        modalImg.style.opacity = '1';
        modal.classList.add('is-ready');
        switching = false;
      }, 230);
    }

    function onKey(e) {
      if (!modalOpen) return;
      if (e.key === 'Escape') { e.preventDefault(); closeModal(); return; }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); return; }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); return; }
      if (e.key === 'Tab') {
        const focusables = [].slice.call(modal.querySelectorAll('button, a[href]')).filter((el) => !el.hidden && el.offsetParent !== null && getComputedStyle(el).display !== 'none');
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        else if (!modal.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
      }
    }

    function onModalClick(e) {
      if (e.target.closest && e.target.closest('[data-hr-close]')) closeModal();
    }

    function onResize() {
      setActive(-1);
      const w = setWidth();
      if (lastSetW && w && w !== lastSetW) scroller.scrollLeft = (scroller.scrollLeft / lastSetW) * w;
      lastSetW = w;
      updateCounter();
    }

    /* ---------- Wiring ---------- */
    scroller.addEventListener('scroll', onScroll, { passive: true });
    scroller.addEventListener('pointerdown', onPointerDown);
    scroller.addEventListener('pointermove', onDragMove);
    scroller.addEventListener('pointerup', endDrag);
    scroller.addEventListener('pointercancel', endDrag);
    scroller.addEventListener('click', onClickCapture, true);
    track.addEventListener('pointermove', onPointerMove, { passive: true });
    track.addEventListener('pointerleave', onPointerLeave, { passive: true });
    track.addEventListener('focusin', onFocusIn);
    track.addEventListener('focusout', onFocusOut);
    track.addEventListener('click', onTrackClick);
    modal.addEventListener('click', onModalClick);
    prevBtn.addEventListener('click', () => go(-1));
    nextBtn.addEventListener('click', () => go(1));
    if (scrollPrev) scrollPrev.addEventListener('click', () => scrollByDir(-1));
    if (scrollNext) scrollNext.addEventListener('click', () => scrollByDir(1));
    window.addEventListener('resize', onResize, { passive: true });
    window.addEventListener('load', startPosition);

    // Start on the middle set so the user can scroll both ways immediately.
    window.requestAnimationFrame(startPosition);

    function cleanup() {
      alive = false;
      window.clearTimeout(closeTimer);
      window.clearTimeout(idleTimer);
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('shopify:section:unload', onUnload);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('load', startPosition);
      unlockScroll();
      if (modal.parentNode) modal.parentNode.removeChild(modal);
      if (root.__hrCleanup === cleanup) root.__hrCleanup = null;
    }

    function onUnload(event) {
      if (event.target === root || (event.target && event.target.contains && event.target.contains(root))) cleanup();
    }

    root.__hrCleanup = cleanup;
    document.addEventListener('shopify:section:unload', onUnload);
  })();
</script>

